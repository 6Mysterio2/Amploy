{
  "manifest_version": 3,
  "name": "Apply Studio \u2014 Personal Companion",
  "version": "0.2.0",
  "description": "Automatically fill application details and draft AI answers from your own profile. Review before submitting.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apply Studio"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "auto-core.js",
        "auto.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
